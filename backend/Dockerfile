# ============================================
# Dockerfile — рецепт «як зібрати й запустити сервер на чужому комп'ютері»
#
# ЩО ТАКЕ DOCKER (простими словами):
# Це спосіб запакувати програму РАЗОМ з усім, що їй треба для роботи —
# потрібною версією Java, налаштуваннями, самим кодом. Виходить «коробка»,
# яка однаково запускається будь-де: на твоєму ноуті, на сервері в інтернеті,
# на комп'ютері одногрупника. Класична біда «а в мене працює» просто зникає.
#
# НАВІЩО НАМ:
# Render (хостинг, куди ми виїжджаємо) не вміє запускати Java «з коробки» —
# він знає Node.js, Python і кілька інших. Зате він уміє запускати Docker.
# Тому ми кажемо: «ось коробка, всередині все є, просто увімкни її».
#
# ЯК ЧИТАТИ ЦЕЙ ФАЙЛ:
# Це покроковий рецепт згори вниз. FROM — «візьми готову основу»,
# COPY — «поклади туди файли», RUN — «виконай команду».
# ============================================


# ============================================
# КРОК 1 — «КУХНЯ»: тут збираємо програму
# ============================================
# Беремо готовий образ, де вже стоїть JDK 21 — повний набір інструментів
# Java, включно з компілятором. Це наша кухня: тут брудно, багато посуду,
# але саме тут із коду народжується готова програма.
#
# eclipse-temurin — безкоштовна збірка Java від Eclipse Foundation.
# AS build — даємо кухні ім'я, щоб потім забрати звідти результат.
FROM eclipse-temurin:21-jdk AS build

WORKDIR /app

# ⚠️ ЧОМУ КОПІЮЄМО ДВОМА ЗАХОДАМИ, А НЕ ВСЕ ОДРАЗУ
#
# Docker запам'ятовує результат кожного кроку. Якщо файли кроку не змінились —
# він не виконує його заново, а бере готове з пам'яті.
#
# Список бібліотек (build.gradle) міняється рідко, а код — щодня. Тому спершу
# копіюємо ТІЛЬКИ описи збірки і качаємо бібліотеки. Далі, коли ти правиш код,
# цей крок пропускається, і повторна збірка займає секунди замість хвилин.
COPY gradlew settings.gradle build.gradle ./
COPY gradle ./gradle
RUN chmod +x ./gradlew

# Качаємо бібліотеки наперед.
# || true — «навіть якщо не вийшло, йди далі»: це лише прогрів кешу,
# справжня збірка нижче все одно докачає, чого бракує.
RUN ./gradlew --no-daemon dependencies || true

# А ось тепер сам код
COPY src ./src

# Збираємо .jar — один файл, у якому лежить уся програма.
# -x test — пропускаємо тести: вони вже проганяються на твоїй машині,
# а на безкоштовному сервері кожна зайва хвилина збірки на вагу золота.
RUN ./gradlew --no-daemon clean bootJar -x test


# ============================================
# КРОК 2 — «ТАРІЛКА»: те, що поїде на сервер
# ============================================
# Тут беремо ІНШИЙ, набагато менший образ: JRE замість JDK.
# JDK = інструменти для написання програм (~450 МБ).
# JRE = тільки те, що треба для ЗАПУСКУ готової (~180 МБ).
#
# Компілятор на сервері не потрібен — програма вже зібрана. Тому кухню
# лишаємо позаду і переносимо на чисту тарілку єдиний файл — .jar.
# Це і зветься multi-stage build: збирали в одному місці, їдемо з іншого.
FROM eclipse-temurin:21-jre

WORKDIR /app

# Забираємо з кухні готовий .jar. Зірочка — щоб не переписувати цей рядок
# щоразу, коли зміниться номер версії в build.gradle.
COPY --from=build /app/build/libs/*.jar app.jar

# ---------- ПАМ'ЯТЬ ----------
# ⚠️ Найважливіший рядок цього файлу.
#
# На безкоштовному Render у нас лише 512 МБ пам'яті. Java за замовчуванням
# вважає, що може взяти багато, поступово роздувається — і сервер її вбиває.
# Ззовні це виглядає як «сайт просто перестав відповідати» без пояснень.
#
# MaxRAMPercentage=70 — «бери не більше 70% від того, що дали». Решту 30%
# лишаємо самій системі, інакше вбивство станеться все одно.
#
# UseSerialGC — прибирання сміття в один потік. Java постійно звільняє
# пам'ять від непотрібного; «розумні» способи це робити швидші, але самі
# їдять пам'ять і люблять кілька ядер. У нас 0.1 ядра — простий спосіб тут
# виграє.
#
# Xss512k — скільки пам'яті кожній «доріжці» виконання. За замовчуванням 1 МБ
# на кожну, а їх десятки. Половини вистачає з запасом.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k"

# Підказка (не команда): «програма всередині слухає цей номер».
# Справжній номер задає сам Render через змінну PORT — її читає
# application.properties у рядку server.port=${PORT:8081}
EXPOSE 8081

# Команда, яка запускається, коли коробку вмикають
ENTRYPOINT ["java", "-jar", "app.jar"]
